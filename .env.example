# Backend selection: default is stub (no network). Set one of these to 1.
USE_REAL_LLM=0
USE_LOCAL_LLM=0

# Anthropic backend (requires USE_REAL_LLM=1)
ANTHROPIC_API_KEY=

# Local backend (requires USE_LOCAL_LLM=1). This profile targets Ollama on Linux/NVIDIA.
# ODA-Fin-RL-8B is a March 2026 Qwen3 finance fine-tune whose reported 9-benchmark
# average (74.6) is substantially above Fin-R1 (61.4). Q4_K_M is 5.03 GB and fits a
# 12 GB RTX 3060 with room for context/KV cache.
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=hf.co/alexsabaka/ODA-Fin-RL-8B-GGUF:Q4_K_M
LOCAL_LLM_MAX_TOKENS=800
# The compact fundamental JSON has its own tighter cap; generic checks keep the limit above.
FUNDAMENTAL_LLM_MAX_TOKENS=384
# Ollama's OpenAI endpoint accepts high/medium/low/none. Empty keeps compatibility with
# servers that do not implement reasoning_effort.
LOCAL_LLM_REASONING_EFFORT=none
# Qwen3 control token; needed by some GGUF templates even when reasoning_effort=none.
# Empty keeps prompts unchanged for models that do not understand it.
LOCAL_LLM_NO_THINK_DIRECTIVE=/no_think

# NSE trade graph
NSE_SYMBOL=RELIANCE
NSE_PRINCIPAL=100000
# Maximum capital committed to one position.
NSE_MAX_ALLOCATION_PCT=10
# Maximum planned loss if the ATR-based stop is filled.
NSE_MAX_LOSS_PCT=1
NSE_ATR_STOP_MULTIPLE=2
NSE_REWARD_RISK_RATIO=2
# Bump when scoring/risk/prompt semantics change so cohorts remain comparable.
NSE_TECHNICAL_POLICY_ID=technical-relative-participation-v2
NSE_POLICY_VERSION=technical-relative-participation-v2+risk-atr-target-v3+sentiment-volatility-v1+fundamental-sector-v1+llm-prompts-v5
TRADE_LOG_PATH=trade_log.jsonl
# Immutable scan decisions plus derived paper outcomes. JSONL remains a fallback.
EVALUATION_DB_PATH=evaluation.db
# NIFTY NEXT 50 ETF proxy used for benchmark-relative outcomes.
EVALUATION_BENCHMARK_SYMBOL=JUNIORBEES
# Explicit starting assumption: 30 bps subtracted once per completed paper trade.
EVALUATION_ROUND_TRIP_COST_BPS=30

# Index scan (used only when no symbols are passed on the command line)
NSE_INDEX=
NSE_SCAN_LIMIT=
NSE_SCAN_DELAY_SECONDS=1

# Delay after each quote/historical-data call (1 quote + 4 timeframes per symbol) --
# separate from FUNDAMENTALS_CALL_DELAY_SECONDS and NSE_SCAN_DELAY_SECONDS below.
NSE_CALL_DELAY_SECONDS=0.3

# Bypasses intraday_recheck.py's market-hours gate -- testing only, never set this in a
# real cron entry.
NSE_SKIP_MARKET_HOURS_CHECK=0

# Data cache
CACHE_DIR=.cache
FUNDAMENTALS_CACHE_TTL_HOURS=24
INTRADAY_CACHE_TTL_MINUTES=5
# Keep provider data in a short-lived "closing" phase after 15:30 IST before accepting
# and caching the session's final candles.
NSE_MARKET_DATA_GRACE_MINUTES=15

# Delay between each individual NextApi fundamentals call (seven per symbol).
FUNDAMENTALS_CALL_DELAY_SECONDS=0.5
# Integrated-financial XBRL adds one manifest plus up to six filings for a symbol that
# passed the technical gate. Keep these first-party NSE requests deliberately paced.
FINANCIAL_RESULTS_CALL_DELAY_SECONDS=1

# Persistent NSE XBRL shareholding cache. Start it with `docker compose up -d aerospike`;
# warm outside market hours with `uv run warm_shareholding.py FEDERALBNK` or `--index`.
AEROSPIKE_HOST=127.0.0.1
AEROSPIKE_PORT=3000
AEROSPIKE_NAMESPACE=nse
AEROSPIKE_SHAREHOLDING_SET=shareholding
NSE_XBRL_CALL_DELAY_SECONDS=2
NSE_XBRL_JITTER_SECONDS=0.5
NSE_XBRL_LOOKBACK_DAYS=730
NSE_XBRL_MANIFEST_TTL_SECONDS=21600

# Tags every row in trade_log.jsonl -- run_overnight_scan.sh and intraday_recheck.py set
# this themselves; leave as the default for manual/interactive runs.
NSE_SCAN_LABEL=manual

# Local SQLite DB of daily NSE bhavcopy (whole-market OHLCV + delivery %). Run
# `uv run bhavcopy.py backfill` once to populate ~a month of history, then
# `uv run bhavcopy.py` daily (see run_overnight_scan.sh) to keep it current.
BHAVCOPY_DB_PATH=bhavcopy.db
BHAVCOPY_BACKFILL_DAYS=30
BHAVCOPY_REQUEST_DELAY_SECONDS=2
BHAVCOPY_PUBLISH_HOUR_IST=18

# Email alerts (digest.py, intraday_recheck.py). Stub by default -- set EMAIL_ENABLED=1
# to actually send; until then, the composed email is just logged.
EMAIL_ENABLED=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=1
SMTP_TIMEOUT_SECONDS=10
EMAIL_FROM=
# Comma-separated -- one address today, more later, no code change needed.
EMAIL_TO=

# Slack alerts -- posts to an incoming webhook alongside email (not instead of).
# digest.py logs the composed stub while disabled; intraday_recheck.py omits disabled
# channels so enabling one later can still deliver the current deduplicated transition.
SLACK_ENABLED=0
# Create one at https://api.slack.com/messaging/webhooks -- per-channel, no bot/app needed.
SLACK_WEBHOOK_URL=

# Persists per-run/per-symbol delivery transitions so intraday cron runs do not repeat
# unchanged email/Slack alerts. Delete only when you intentionally want to reset dedupe.
INTRADAY_ALERT_STATE_PATH=.intraday_alert_state.json
