# Backend selection: default is stub (no network). Set one of these to 1.
USE_REAL_LLM=0
USE_LOCAL_LLM=0

# Anthropic backend (requires USE_REAL_LLM=1)
ANTHROPIC_API_KEY=

# Local backend (requires USE_LOCAL_LLM=1). This profile targets Ollama on Linux/NVIDIA.
# ODA-Fin-RL-8B is a March 2026 Qwen3 finance fine-tune whose reported 9-benchmark
# average (74.6) is substantially above Fin-R1 (61.4). Q4_K_M is 5.03 GB and fits a
# 12 GB RTX 3060 with room for context/KV cache.
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=hf.co/alexsabaka/ODA-Fin-RL-8B-GGUF:Q4_K_M
LOCAL_LLM_MAX_TOKENS=400
# Ollama's OpenAI endpoint accepts high/medium/low/none. Empty keeps compatibility with
# servers that do not implement reasoning_effort.
LOCAL_LLM_REASONING_EFFORT=none
# Qwen3 control token; needed by some GGUF templates even when reasoning_effort=none.
# Empty keeps prompts unchanged for models that do not understand it.
LOCAL_LLM_NO_THINK_DIRECTIVE=/no_think

# NSE trade graph
NSE_SYMBOL=RELIANCE
NSE_PRINCIPAL=100000
# Maximum capital committed to one position.
NSE_MAX_ALLOCATION_PCT=10
# Maximum planned loss if the ATR-based stop is filled.
NSE_MAX_LOSS_PCT=1
NSE_ATR_STOP_MULTIPLE=2
TRADE_LOG_PATH=trade_log.jsonl

# Index scan (used only when no symbols are passed on the command line)
NSE_INDEX=
NSE_SCAN_LIMIT=
NSE_SCAN_DELAY_SECONDS=1

# Delay after each quote/historical-data call (1 quote + 4 timeframes per symbol) --
# separate from FUNDAMENTALS_CALL_DELAY_SECONDS and NSE_SCAN_DELAY_SECONDS below.
NSE_CALL_DELAY_SECONDS=0.3

# Bypasses intraday_recheck.py's market-hours gate -- testing only, never set this in a
# real cron entry.
NSE_SKIP_MARKET_HOURS_CHECK=0

# Data cache
CACHE_DIR=.cache
FUNDAMENTALS_CACHE_TTL_HOURS=24
INTRADAY_CACHE_TTL_MINUTES=5

# Delay between each individual fundamentals API call (get_fundamental_snapshot makes
# ~7 calls per symbol) -- separate from NSE_SCAN_DELAY_SECONDS, which is between symbols.
FUNDAMENTALS_CALL_DELAY_SECONDS=0.5

# Tags every row in trade_log.jsonl -- run_overnight_scan.sh and intraday_recheck.py set
# this themselves; leave as the default for manual/interactive runs.
NSE_SCAN_LABEL=manual

# Local SQLite DB of daily NSE bhavcopy (whole-market OHLCV + delivery %). Run
# `uv run bhavcopy.py backfill` once to populate ~a month of history, then
# `uv run bhavcopy.py` daily (see run_overnight_scan.sh) to keep it current.
BHAVCOPY_DB_PATH=bhavcopy.db
BHAVCOPY_BACKFILL_DAYS=30
BHAVCOPY_REQUEST_DELAY_SECONDS=2
BHAVCOPY_PUBLISH_HOUR_IST=18

# Email alerts (digest.py, intraday_recheck.py). Stub by default -- set EMAIL_ENABLED=1
# to actually send; until then, the composed email is just logged.
EMAIL_ENABLED=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=1
EMAIL_FROM=
# Comma-separated -- one address today, more later, no code change needed.
EMAIL_TO=

# Slack alerts (digest.py, intraday_recheck.py) -- posts to an incoming webhook, sent
# alongside email (not instead of). Stub by default, same pattern as EMAIL_ENABLED:
# until SLACK_ENABLED=1, the composed message is just logged.
SLACK_ENABLED=0
# Create one at https://api.slack.com/messaging/webhooks -- per-channel, no bot/app needed.
SLACK_WEBHOOK_URL=
