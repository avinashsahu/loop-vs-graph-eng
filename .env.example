# Backend selection: default is stub (no network). Set one of these to 1.
USE_REAL_LLM=0
USE_LOCAL_LLM=0

# Anthropic backend (requires USE_REAL_LLM=1)
ANTHROPIC_API_KEY=

# Local gemma4 backend (requires USE_LOCAL_LLM=1)
LOCAL_LLM_URL=http://localhost:8080/v1
LOCAL_LLM_MODEL=mlx-community/gemma-4-12B-it-4bit
LOCAL_LLM_MAX_TOKENS=300

# NSE trade graph
NSE_SYMBOL=RELIANCE
NSE_PRINCIPAL=100000
NSE_RISK_PCT=10
TRADE_LOG_PATH=trade_log.jsonl

# Index scan (used only when no symbols are passed on the command line)
NSE_INDEX=
NSE_SCAN_LIMIT=
NSE_SCAN_DELAY_SECONDS=1

# Delay after each quote/historical-data call (1 quote + 4 timeframes per symbol) --
# separate from FUNDAMENTALS_CALL_DELAY_SECONDS and NSE_SCAN_DELAY_SECONDS below.
NSE_CALL_DELAY_SECONDS=0.3

# Bypasses intraday_recheck.py's market-hours gate -- testing only, never set this in a
# real cron entry.
NSE_SKIP_MARKET_HOURS_CHECK=0

# Data cache
CACHE_DIR=.cache
FUNDAMENTALS_CACHE_TTL_HOURS=24
INTRADAY_CACHE_TTL_MINUTES=5

# Delay between each individual fundamentals API call (get_fundamental_snapshot makes
# ~7 calls per symbol) -- separate from NSE_SCAN_DELAY_SECONDS, which is between symbols.
FUNDAMENTALS_CALL_DELAY_SECONDS=0.5

# Tags every row in trade_log.jsonl -- run_overnight_scan.sh and intraday_recheck.py set
# this themselves; leave as the default for manual/interactive runs.
NSE_SCAN_LABEL=manual

# Email alerts (digest.py, intraday_recheck.py). Stub by default -- set EMAIL_ENABLED=1
# to actually send; until then, the composed email is just logged.
EMAIL_ENABLED=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=1
EMAIL_FROM=
# Comma-separated -- one address today, more later, no code change needed.
EMAIL_TO=
